---
import { TEAM } from "@/lib/credits-content";
import Layout from "@/layouts/main.astro";
import { SITE_NAME } from "@/consts";
import Footer from "@/layouts/Footer.astro";

// "a", "a and b" or "a, b and c".
const names = new Intl.ListFormat("en", { type: "conjunction" });
---

<Layout
  title={`Credits | ${SITE_NAME}`}
  description="The people who organize, produce, and build MCSR Ranked Leagues."
>
  <div class="mx-auto min-h-screen max-w-page px-6 pt-24 pb-14 md:pb-20">
    <h1 class="text-pixel-lg md:text-pixel-xl">Credits</h1>
    <p class="mt-3 max-w-[50ch] text-lg text-muted">
      The people who organize, produce and build {SITE_NAME}.
    </p>
    <dl class="mt-10 border-b border-border">
      {TEAM.roles.map((role) => (
        <div class="grid gap-x-10 gap-y-2 border-t border-border py-6 md:grid-cols-[16rem_minmax(0,1fr)]">
          <dt class="font-minecraft text-pixel-sm pixel-shadow">{role.name}</dt>
          <dd class="max-w-[70ch] text-lg">
            <p>
              <span class="text-muted">Led by</span>{" "}
              <span class="font-minecraft wrap-anywhere pixel-shadow">
                {names.format(role.leaders)}
              </span>
            </p>
            <p class="mt-1 font-minecraft text-muted wrap-anywhere">
              {role.members.join(", ")}
            </p>
          </dd>
        </div>
      ))}
    </dl>

    <p class="mt-6 text-muted">Plus hundreds of other people.</p>
  </div>
  <Footer />
</Layout>
