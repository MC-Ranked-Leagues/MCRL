---
import Layout from "@/layouts/main.astro";
import Footer from "@/layouts/Footer.astro";
import { LatestWinners } from "@/components/home/LatestWinners";
import { LeagueFinder } from "@/components/home/LeagueFinder";
import { LeagueSim } from "@/components/home/LeagueSim";
import { DISCORD_URL, TWITCH_URL, YOUTUBE_URL } from "@/links";
import { cn } from "@/lib/utils";

const JOIN_STEPS = [
  "Join the Discord",
  "Sign up and get placed in a league",
  "Show up at the given time and speedrun the game",
];

const FAQ = [
  {
    question: "Do I have to play every week?",
    answer: "No. You register for the weeks you want to play.",
  },
  {
    question: "What if I can't make it after registering?",
    answer:
      "You can unregister anytime before the matches start. Either way, if you don't play any seeds, you're just listed as missed and you won't be counted.",
  },
  {
    question: "Which league will I start in?",
    answer: "A reviewer looks at your Ranked stats and places you.",
  },
];

const heading = "text-pixel-md md:text-pixel-lg";
const primaryButton =
  "inline-block bg-primary px-6 py-3 font-minecraft text-lg font-bold text-primary-foreground transition-colors hover:bg-primary-hover";
const outlineButton =
  "inline-block border-2 border-border px-5 py-2.5 text-lg font-semibold transition-colors hover:border-foreground";
const textLink =
  "font-semibold underline decoration-muted underline-offset-4 transition-colors hover:decoration-foreground";
---

<Layout description="Weekly Minecraft speedrun races against players at your level, for beginners and top runners alike.">
  <section class="relative overflow-hidden">
    <img
      src="/images/4.webp"
      alt=""
      fetchpriority="high"
      class="absolute inset-0 size-full object-cover"
    />
    {/* Darkens the picture behind the text and the sim, so both stay
        readable. */}
    <div class="absolute inset-0 bg-linear-to-t from-background/80 via-background/70 to-background/40 lg:bg-linear-to-r lg:from-background/95 lg:via-background/70 lg:to-background/50"></div>
    <div class="relative mx-auto grid max-w-page grid-cols-[minmax(0,1fr)] items-center gap-10 px-6 pt-28 pb-12 lg:min-h-160 lg:grid-cols-[1fr_minmax(0,34rem)]">
      <div>
        <h1 class="text-pixel-lg md:text-pixel-xl">Ranked Leagues</h1>
        <p class="mt-4 mb-7 max-w-[38ch] text-lg md:text-xl">
          Play against people at your level and climb seven leagues. Beginners
          welcome.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href={DISCORD_URL}
            target="_blank"
            rel="noopener noreferrer"
            class={primaryButton}
          >
            Join on Discord
          </a>
          <a
            href={TWITCH_URL}
            target="_blank"
            rel="noopener noreferrer"
            class={outlineButton}
          >
            Watch on Twitch
          </a>
        </div>
      </div>
      <LeagueSim client:load />
    </div>
  </section>

  <LatestWinners client:load />

  <section class="py-14 md:py-20">
    <div class="mx-auto max-w-page px-6">
      <LeagueFinder client:load />
    </div>
  </section>

  <section class="border-y border-border bg-background-deep py-14 md:py-20">
    <div class="mx-auto grid max-w-page grid-cols-[minmax(0,1fr)] gap-x-16 gap-y-12 px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)]">
      <div>
        <h2 class={heading}>How to join</h2>
        <ol class="mt-6 mb-7 border-b border-border">
          {JOIN_STEPS.map((step, i) => (
            <li class="grid grid-cols-[2rem_1fr] items-baseline border-t border-border py-3">
              <span class="font-minecraft text-pixel-sm text-muted">
                {i + 1}
              </span>
              <span class="text-lg font-semibold">{step}</span>
            </li>
          ))}
        </ol>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <a
            href={DISCORD_URL}
            target="_blank"
            rel="noopener noreferrer"
            class={primaryButton}
          >
            Join on Discord
          </a>
          <a href="/info/registration" class={textLink}>
            Full sign-up guide
          </a>
        </div>
      </div>
      <div>
        <h2 class="text-pixel-sm">Questions</h2>
        <div class="mt-4 border-b border-border">
          {FAQ.map((item) => (
            <div class="border-t border-border py-4">
              <h3 class="font-display text-lg leading-snug font-bold text-shadow-none">
                {item.question}
              </h3>
              <p class="mt-1.5 max-w-[60ch] text-muted">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="grid items-center lg:grid-cols-2">
    <img
      src="/images/1.webp"
      alt="Players gathered in a nether fortress"
      loading="lazy"
      class="size-full min-h-64 object-cover lg:min-h-96"
    />
    <div class="px-6 py-12 lg:px-16">
      <h2 class={heading}>Watch it live</h2>
      <p class="mt-4 mb-6 max-w-[38ch] text-lg">
        Follow ranked leagues live on Twitch every weekend.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href={TWITCH_URL}
          target="_blank"
          rel="noopener noreferrer"
          class={outlineButton}
        >
          Twitch
        </a>
        <a
          href={YOUTUBE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class={outlineButton}
        >
          YouTube
        </a>
      </div>
      <a
        href="/info/extra/share-stream"
        class={cn(textLink, "mt-6 inline-block")}
      >
        Playing yourself? Share your stream
      </a>
    </div>
  </section>

  <Footer />
</Layout>
