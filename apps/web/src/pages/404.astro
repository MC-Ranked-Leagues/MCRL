---
import Layout from "@/layouts/main.astro";
import Footer from "@/layouts/Footer.astro";
import { SITE_NAME } from "@/consts";
---

<Layout title={`Page not found | ${SITE_NAME}`}>
  <div class="mx-auto min-h-screen max-w-page px-6 pt-24 pb-14 md:pb-20">
    <h1 class="text-pixel-lg md:text-pixel-xl">Page not found</h1>
    <p class="mt-5 text-muted">This page doesn't exist.</p>
    <a
      href="/"
      class="mt-3 inline-block font-semibold underline decoration-muted underline-offset-4 transition-colors hover:decoration-foreground"
    >
      Go to the home page
    </a>
  </div>
  <Footer />
</Layout>
