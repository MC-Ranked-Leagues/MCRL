---
import "@/global.css";
import Navbar from "@/layouts/Navbar.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "@/consts";

interface Props {
  title?: string;
  description?: string;
  // For pages that set their own canonical link in the browser.
  noCanonical?: boolean;
}

const { title, description, noCanonical } = Astro.props;
// Left out when `SITE_URL` isn't set, such as on preview deployments.
const canonicalUrl =
  !noCanonical && Astro.site && new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/webp" href="/MCRL.webp" />
    <title>{title || SITE_TITLE}</title>
    <meta name="description" content={description || SITE_DESCRIPTION} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
  </head>
  <body class="dark">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-60 focus:bg-background focus:px-4 focus:py-2"
    >
      Skip to content
    </a>
    <Navbar />
    <main id="main">
      <slot />
    </main>
  </body>
</html>
