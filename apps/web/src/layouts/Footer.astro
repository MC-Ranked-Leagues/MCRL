---

<footer class="border-t border-border bg-background-deep text-foreground">
  <div class="mx-auto max-w-page px-6 py-8">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
        <a href="/" class="flex items-center gap-2.5">
          <img
            src="/MCRL.webp"
            alt=""
            width="32"
            height="32"
            loading="lazy"
            class="size-8 [image-rendering:pixelated]"
          />
          <span class="font-minecraft text-pixel-sm pixel-shadow">
            {SITE_NAME}
          </span>
        </a>
        <div class="flex items-center gap-4 text-muted">
          {SOCIAL_LINKS.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.name}
              class="transition-colors hover:text-foreground"
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                class="size-5 fill-current"
              >
                <path d={link.path} />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <nav
        aria-label="Footer navigation"
        class="flex gap-7 font-minecraft text-sm text-muted"
      >
        <a
          href={DISCORD_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-foreground"
        >
          Contact
        </a>
        <a href="/credits" class="transition-colors hover:text-foreground">
          Credits
        </a>
      </nav>
    </div>

    <p class="mt-6 border-t border-border pt-6 text-sm text-muted">
      © 2026 MC Ranked Leagues. This is not an official Minecraft product. Not
      approved by or associated with Mojang or Microsoft.
    </p>
  </div>
</footer>
