---
import { Menu, X } from "lucide-react";
import { SITE_NAME } from "@/consts";
import { DISCORD_URL } from "@/links";
import { cn } from "@/lib/utils";

const NAV_LINKS = [
  { name: "Home", href: "/" },
  { name: "Stats", href: "/stats" },
  { name: "Leaderboard", href: "/week" },
  { name: "Info", href: "/info" },
];

// `/week` covers every week's URL.
const { pathname } = Astro.url;
const isCurrent = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<nav
  id="navbar"
  class="fixed top-0 right-0 left-0 z-50 border-b border-border bg-background text-foreground"
>
  <div class="mx-auto flex h-14 max-w-page items-center justify-between gap-6 px-6">
    <a href="/" class="flex items-center gap-2.5">
      <img
        src="/MCRL.webp"
        alt=""
        width="32"
        height="32"
        class="size-8 [image-rendering:pixelated]"
      />
      <span class="font-minecraft text-pixel-sm pixel-shadow">{SITE_NAME}</span>
    </a>

    <div class="hidden h-full items-center gap-7 md:flex">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          aria-current={isCurrent(link.href) ? "page" : undefined}
          class={cn(
            // The current page's bar sits on the navbar's bottom edge.
            "flex h-full items-center border-y-2 border-transparent font-minecraft text-sm transition-colors hover:text-foreground",
            isCurrent(link.href)
              ? "border-b-primary pixel-shadow"
              : "text-muted"
          )}
        >
          {link.name}
        </a>
      ))}
      <a
        href={DISCORD_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="border-2 border-border px-3.5 py-1 font-minecraft text-sm font-bold transition-colors hover:border-foreground"
      >
        Discord
      </a>
    </div>

    <button
      id="menu-toggle"
      class="-mr-2 p-2 md:hidden"
      aria-label="Toggle Menu"
      aria-expanded="false"
    >
      <Menu className="size-6" id="icon-menu" />
      <X className="hidden size-6" id="icon-close" />
    </button>
  </div>
</nav>

<div
  id="mobile-menu"
  class="fixed inset-0 z-40 hidden flex-col bg-background px-6 pt-20 text-foreground md:hidden"
>
  {NAV_LINKS.map((link) => (
    <a
      href={link.href}
      aria-current={isCurrent(link.href) ? "page" : undefined}
      class={cn(
        "border-b border-border py-4 font-minecraft text-pixel-md",
        !isCurrent(link.href) && "text-muted"
      )}
    >
      {link.name}
    </a>
  ))}
  <a
    href={DISCORD_URL}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-8 block bg-primary px-6 py-3.5 text-center font-minecraft text-lg font-bold text-primary-foreground"
  >
    Join on Discord
  </a>
</div>

<script>
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconMenu = document.getElementById("icon-menu");
  const iconClose = document.getElementById("icon-close");

  function setMenuOpen(isOpen: boolean) {
    mobileMenu?.classList.toggle("hidden", !isOpen);
    mobileMenu?.classList.toggle("flex", isOpen);
    iconMenu?.classList.toggle("hidden", isOpen);
    iconClose?.classList.toggle("hidden", !isOpen);
    menuToggle?.setAttribute("aria-expanded", String(isOpen));
    document.body.style.overflow = isOpen ? "hidden" : "";
  }

  menuToggle?.addEventListener("click", () => {
    setMenuOpen(mobileMenu?.classList.contains("hidden") ?? false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !mobileMenu?.classList.contains("hidden")) {
      setMenuOpen(false);
    }
  });
</script>
