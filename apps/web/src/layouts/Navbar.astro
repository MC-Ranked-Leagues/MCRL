---
import { Menu, X } from "lucide-react";
import { DISCORD_URL } from "@/consts";

const NAV_LINKS = [
  { name: "Home", href: "/" },
  { name: "Stats", href: "/stats" },
  { name: "Leaderboard", href: "/week" },
  { name: "Championship", href: "/championship" },
  { name: "Info", href: "/info" },
];
---

<nav
  id="navbar"
  class="animate-slide-down fixed top-0 right-0 left-0 z-50 border-b border-transparent text-home-text opacity-0 transition-colors duration-300"
>
  <div
    class="mx-auto flex max-w-304 items-center justify-between gap-6 px-6 py-3"
  >
    <a href="/" class="flex items-center gap-2.5">
      <img
        src="/MCRL.webp"
        alt=""
        width="32"
        height="32"
        class="size-8 [image-rendering:pixelated]"
      />
      <span class="font-minecraft text-lg font-bold">Ranked Leagues</span>
    </a>

    {/* Desktop Links */}
    <div class="hidden items-center gap-7 md:flex">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="font-minecraft text-sm transition-colors hover:text-home-gold"
          >
            {link.name}
          </a>
        ))
      }
      <a
        href={DISCORD_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-lava px-4 py-2 font-minecraft text-sm font-bold text-lava-ink transition-colors hover:bg-lava-hover"
      >
        Discord
      </a>
    </div>

    {/* Mobile Toggle */}
    <div class="md:hidden">
      <button
        id="menu-toggle"
        class="p-2 transition-colors hover:text-home-gold"
        aria-label="Toggle Menu"
        aria-expanded="false"
      >
        <Menu className="h-6 w-6" id="icon-menu" />
        <X className="hidden h-6 w-6" id="icon-close" />
      </button>
    </div>
  </div>
</nav>

{/* Mobile Menu Overlay */}
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 hidden flex-col bg-obsidian px-6 pt-24 text-home-text md:hidden"
>
  <div class="flex flex-col gap-6">
    {
      NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class="font-minecraft text-3xl transition-colors hover:text-home-gold"
        >
          {link.name}
        </a>
      ))
    }
    <div class="mt-8 border-t border-obsidian-line pt-8">
      <a
        href={DISCORD_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="block bg-lava px-6 py-4 text-center font-minecraft text-xl font-bold text-lava-ink transition-colors hover:bg-lava-hover"
      >
        Join on Discord
      </a>
    </div>
  </div>
</div>

<script>
  const navbar = document.getElementById("navbar");
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconMenu = document.getElementById("icon-menu");
  const iconClose = document.getElementById("icon-close");

  function setNavbarSolid(isSolid: boolean) {
    navbar?.classList.toggle("bg-obsidian", isSolid);
    navbar?.classList.toggle("border-obsidian-line", isSolid);
    navbar?.classList.toggle("border-transparent", !isSolid);
  }

  // Handle scroll
  window.addEventListener("scroll", () => {
    setNavbarSolid(window.scrollY > 20);
  });

  function setMenuOpen(isOpen: boolean) {
    mobileMenu?.classList.toggle("hidden", !isOpen);
    mobileMenu?.classList.toggle("flex", isOpen);
    iconMenu?.classList.toggle("hidden", isOpen);
    iconClose?.classList.toggle("hidden", !isOpen);
    menuToggle?.setAttribute("aria-expanded", String(isOpen));
    document.body.style.overflow = isOpen ? "hidden" : "unset";
    setNavbarSolid(isOpen || window.scrollY > 20);
  }

  // Handle menu toggle
  menuToggle?.addEventListener("click", () => {
    setMenuOpen(mobileMenu?.classList.contains("hidden") ?? false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !mobileMenu?.classList.contains("hidden")) {
      setMenuOpen(false);
    }
  });
</script>
