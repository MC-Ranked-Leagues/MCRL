{
  "name": "@mcrl/bot",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "commands:deploy": "bun scripts/deploy-commands.ts",
    "db:generate": "drizzle-kit generate --config config/drizzle.ts",
    "db:migrate": "bun scripts/migrate-database.ts",
    "db:reset": "bun scripts/reset-database.ts",
    "db:studio": "drizzle-kit studio --config config/drizzle.ts",
    "lint": "bun run --cwd ../.. eslint apps/bot --report-unused-disable-directives --max-warnings 0",
    "format": "bun run --cwd ../.. prettier --write apps/bot",
    "format:check": "bun run --cwd ../.. prettier --check apps/bot",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.10"
  }
}
