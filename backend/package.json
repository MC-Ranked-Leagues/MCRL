{
  "name": "@mcrl/backend",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./data-model": {
      "types": "./convex/_generated/dataModel.d.ts"
    }
  },
  "scripts": {
    "dev": "convex dev",
    "lint": "bun run --cwd .. eslint backend --report-unused-disable-directives --max-warnings 0",
    "format": "bun run --cwd .. prettier --write backend",
    "format:check": "bun run --cwd .. prettier --check backend",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "bun run --parallel --no-exit-on-error typecheck:convex typecheck:config",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "typecheck:config": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "convex": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "catalog:",
    "convex-test": "^0.0.49",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
