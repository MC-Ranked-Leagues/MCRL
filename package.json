{
  "name": "mcrl",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "apps/*",
      "backend"
    ],
    "catalog": {
      "@base-ui/react": "^1.9.0",
      "@fontsource-variable/archivo": "^5.3.0",
      "@fontsource-variable/inter": "^5.3.0",
      "@tailwindcss/vite": "^4.3.5",
      "@types/node": "^24.19.2",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "clsx": "^2.1.1",
      "convex": "^1.49.0",
      "mcsrranked-sdk": "^0.2.0",
      "lucide-react": "^1.70.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "shadcn": "^4.23.0",
      "tailwind-merge": "^3.7.0",
      "tailwindcss": "^4.3.5",
      "tw-animate-css": "^1.4.0",
      "vaul": "^1.1.2",
      "vite": "^8.3.6",
      "vitest": "^5.1.0",
      "zod": "^4.6.7"
    }
  },
  "scripts": {
    "dev": "bun run --parallel dev:web dev:backend",
    "dev:bot": "bun run --filter @mcrl/bot dev",
    "start:bot": "bun run --filter @mcrl/bot start",
    "bot:deploy": "bun run --filter @mcrl/bot commands:deploy",
    "bot:migrate": "bun run --filter @mcrl/bot db:migrate",
    "bot:reset": "bun run --filter @mcrl/bot db:reset",
    "dev:web": "bun run --filter @mcrl/web dev",
    "dev:backend": "bun run --filter @mcrl/backend dev",
    "typecheck": "bun run --parallel --no-exit-on-error typecheck:workspaces typecheck:scripts",
    "typecheck:bot": "bun run --filter @mcrl/bot typecheck",
    "typecheck:web": "bun run --filter @mcrl/web typecheck",
    "typecheck:backend": "bun run --filter @mcrl/backend typecheck",
    "typecheck:workspaces": "bun run --filter '@mcrl/*' --no-exit-on-error typecheck",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "test": "bun run --filter '@mcrl/*' test",
    "test:web": "bun run --filter @mcrl/web test",
    "test:backend": "bun run --filter @mcrl/backend test",
    "build": "bun run build:web",
    "build:cloudflare:league": "bun ci && bun run build:web",
    "build:web": "bun run --filter @mcrl/web build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:bot": "bun run --filter @mcrl/bot lint",
    "lint:web": "bun run --filter @mcrl/web lint",
    "lint:backend": "bun run --filter @mcrl/backend lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "league-summary": "bun scripts/generate-league-summary.ts"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
