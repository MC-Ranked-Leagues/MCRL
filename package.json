{
  "name": "mcrl",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "apps/*",
      "backend"
    ],
    "catalog": {
      "@base-ui/react": "^1.4.0",
      "@fontsource-variable/inter": "^5.2.8",
      "@tailwindcss/vite": "^4.2.2",
      "@types/node": "^24.12.2",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "convex": "^1.35.1",
      "lucide-react": "^1.8.0",
      "react": "^19.2.5",
      "react-dom": "^19.2.5",
      "shadcn": "^4.2.0",
      "tailwind-merge": "^3.5.0",
      "tailwindcss": "^4.2.2",
      "tw-animate-css": "^1.4.0",
      "vaul": "^1.1.2",
      "vite": "^7.3.2",
      "vitest": "^4.1.5",
      "zod": "^4.3.6"
    }
  },
  "scripts": {
    "dev": "bun run --parallel dev:web dev:backend",
    "dev:web": "bun run --filter @mcrl/web dev",
    "dev:backend": "bun run --filter @mcrl/backend dev",
    "typecheck": "bun run --parallel --no-exit-on-error typecheck:workspaces typecheck:scripts",
    "typecheck:web": "bun run --filter @mcrl/web typecheck",
    "typecheck:backend": "bun run --filter @mcrl/backend typecheck",
    "typecheck:workspaces": "bun run --filter '@mcrl/*' --no-exit-on-error typecheck",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "test": "bun run --filter '@mcrl/*' test",
    "test:web": "bun run --filter @mcrl/web test",
    "test:backend": "bun run --filter @mcrl/backend test",
    "build": "bun run build:web",
    "build:cloudflare:league": "bun ci && bun run build:web",
    "build:web": "bun run --filter @mcrl/web build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:web": "bun run --filter @mcrl/web lint",
    "lint:backend": "bun run --filter @mcrl/backend lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^1.2.2",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "prettier": "^3.8.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.1"
  }
}
