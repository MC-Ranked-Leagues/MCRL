{
  "name": "mcrl",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "domains/league",
    "domains/seed",
    "packages/*"
  ],
  "scripts": {
    "dev:league": "bun run --filter @mcrl/league dev",
    "dev:seed": "bun run --filter @mcrl/seed dev",
    "typecheck": "bun run --filter '@mcrl/*' typecheck",
    "test": "bun run --filter '@mcrl/*' test",
    "build": "bun run --filter '@mcrl/*' build",
    "lint": "bun run --filter '@mcrl/*' lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^1.2.2",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "convex-test": "^0.0.49",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "prettier": "^3.8.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.5"
  }
}
