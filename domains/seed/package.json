{
  "name": "@mcrl/seed",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {},
  "scripts": {
    "dev": "bun run --parallel 'dev:*'",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:convex": "convex dev",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "bun run --parallel --no-exit-on-error 'typecheck:*'",
    "typecheck:web": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "typecheck:config": "tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:once": "bun run test",
    "test:watch": "vitest",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "preview": "vite preview --config web/vite.config.ts",
    "format": "bun run --cwd ../.. prettier --write domains/seed",
    "format:check": "bun run --cwd ../.. prettier --check domains/seed"
  },
  "dependencies": {
    "@auth/core": "0.37.0",
    "@base-ui/react": "catalog:",
    "@convex-dev/auth": "^0.0.91",
    "@fontsource-variable/inter": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "^1.1.1",
    "convex": "catalog:",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "catalog:",
    "next-themes": "^0.4.6",
    "react": "catalog:",
    "react-day-picker": "^9.14.0",
    "react-dom": "catalog:",
    "react-resizable-panels": "^4.10.0",
    "react-router": "^7.14.0",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "catalog:",
    "vaul": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^17.4.2",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  }
}
