{
  "name": "@mcrl/league",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {},
  "scripts": {
    "dev": "bun run --parallel 'dev:*'",
    "dev:web": "astro dev --root web",
    "dev:convex": "convex dev",
    "build": "astro build --root web",
    "preview": "astro preview --root web",
    "astro": "astro --root web",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "bun run --cwd ../.. prettier --write domains/league",
    "format:check": "bun run --cwd ../.. prettier --check domains/league",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "bun run --parallel --no-exit-on-error 'typecheck:*'",
    "typecheck:web": "astro check --root web",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json"
  },
  "dependencies": {
    "@mcrl/contracts": "workspace:*",
    "@astrojs/check": "^0.9.7",
    "@astrojs/react": "^4.4.2",
    "@astrojs/starlight": "^0.38.2",
    "@base-ui/react": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "astro": "^6.0.8",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "convex": "catalog:",
    "echarts": "^6.1.0",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "catalog:",
    "vaul": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  }
}
