---
import { CustomButton } from "@/components/ui-custom/Button"
---

<section
  class="animate-slide-up container mx-auto max-w-4xl border-t border-primary/10 px-6 py-24 text-center opacity-0"
>
  <h2
    class="mb-6 font-minecraft text-4xl tracking-tighter uppercase md:text-7xl"
  >
    Ready to <span class="text-primary italic">Speedrun?</span>
  </h2>

  <p class="mx-auto mb-12 max-w-2xl text-xl text-muted-foreground">
    The next week is about to start. Secure your spot in the leagues and show
    the world what you're capable of.
  </p>

  <div class="flex flex-col items-center justify-center gap-6 sm:flex-row">
    <CustomButton
      size="lg"
      className="h-16 px-16 text-xl"
      href="/registration/process"
      target="_self"
    >
      Join the League
    </CustomButton>
    <CustomButton
      variant="outline"
      size="lg"
      href="/week"
      className="h-16 px-16 text-xl"
      minecraft={false}
    >
      View Weekly Stats
    </CustomButton>
  </div>
</section>
