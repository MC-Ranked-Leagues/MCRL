---
import { TEAM } from "@/lib/credits-content"
import Layout from "@/layouts/main.astro"
import FooterCTA from "@/layouts/Footer.astro"

const TOTAL_PEOPLE = new Set(
  TEAM.roles.flatMap((role) => [...role.leaders, ...role.members])
).size
---

<Layout
  title="Credits | MCSR Ranked Leagues"
  description="The people who organize, produce, and build MCSR Ranked Leagues."
>
  <div class="min-h-screen bg-background px-6 pt-32 pb-16 sm:pt-36">
    <div class="mx-auto max-w-5xl">
      <header
        class="animate-slide-up flex flex-col gap-5 border-b border-border pb-9 opacity-0 sm:flex-row sm:items-end sm:justify-between"
      >
        <h1
          class="max-w-3xl font-minecraft text-4xl leading-none tracking-tight text-foreground sm:text-6xl"
        >
          {TEAM.title}
        </h1>
        <p class="shrink-0 font-minecraft text-sm text-muted-foreground">
          {TOTAL_PEOPLE} people &middot; {TEAM.roles.length} teams
        </p>
      </header>

      <div class="grid lg:grid-cols-2">
        {
          TEAM.roles.map((role, index) => (
            <section
              class:list={[
                "animate-slide-up grid gap-5 border-b border-border py-8 opacity-0 sm:grid-cols-[11rem_1fr] sm:gap-6 lg:px-7",
                index % 2 === 0 ? "lg:pl-0" : "lg:border-l lg:pr-0",
              ]}
              style={`animation-delay: ${100 + index * 70}ms`}
              aria-labelledby={`role-${index}`}
            >
              <div class="flex items-baseline gap-3">
                <span
                  class="font-minecraft text-xs text-muted-foreground/50"
                  aria-hidden="true"
                >
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div>
                  <h2
                    id={`role-${index}`}
                    class="font-minecraft text-base leading-tight text-foreground"
                  >
                    {role.name}
                  </h2>
                  <p class="mt-1 text-xs text-muted-foreground">
                    {role.leaders.length + role.members.length} people
                  </p>
                </div>
              </div>

              <div class="space-y-4">
                <div>
                  <p class="mb-1.5 text-[0.65rem] tracking-[0.18em] text-primary uppercase">
                    {role.leaders.length === 1 ? "Lead" : "Leads"}
                  </p>
                  <p class="font-minecraft text-sm leading-relaxed text-foreground">
                    {role.leaders.join(" / ")}
                  </p>
                </div>
                <ul class="flex flex-wrap gap-x-4 gap-y-1.5 text-sm text-muted-foreground">
                  {role.members.map((member) => (
                    <li>{member}</li>
                  ))}
                </ul>
              </div>
            </section>
          ))
        }
      </div>
      <p class="mx-auto mt-8 w-fit text-sm text-muted-foreground">
        Plus hundreds of other people
      </p>
    </div>
  </div>
  <FooterCTA />
</Layout>
