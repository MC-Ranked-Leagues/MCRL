---

<footer>
  <div class="mx-auto max-w-4xl px-6 py-8">
    <div
      class="flex flex-col gap-6 px-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="flex items-center gap-5">
        <a
          href="/"
          class="font-minecraft text-lg text-foreground transition-colors hover:text-primary"
        >
          Ranked Leages
        </a>
        <div class="flex items-center gap-3 text-muted-foreground">
          {
            SOCIAL_LINKS.map(
              (link) =>
                link.href && (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={link.name}
                    class="transition-colors hover:text-primary"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      class="size-5 fill-current"
                    >
                      <path d={link.path} />
                    </svg>
                  </a>
                )
            )
          }
        </div>
      </div>

      <nav aria-label="Footer navigation" class="flex gap-7 text-sm">
        <a
          href="https://discord.gg/zzptZsec42"
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted-foreground transition-colors hover:text-foreground"
        >
          Contact
        </a>
        <a
          href="/credits"
          class="text-muted-foreground transition-colors hover:text-foreground"
        >
          Credits
        </a>
      </nav>
    </div>

    <p
      class="mt-2 pt-2 text-center text-[0.68rem] leading-relaxed tracking-wide text-muted-foreground/60 uppercase"
    >
      © 2026 MC Ranked Leagues. This is not an official Minecraft product. Not
      approved by or associated with Mojang or Microsoft.
    </p>
  </div>
</footer>
